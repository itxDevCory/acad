# Vercel Ignore File
# Files and directories to exclude from deployment

# Development
node_modules
.next
.env*.local

# Testing
coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentation (optional - remove if you want docs deployed)
# *.md
# !README.md

# Local data
data/*
projects/*
models/*

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Temporary
*.tmp
*.temp
.cache

# Git
.git
.gitignore
